{
  "name": "js-boilerplate-component",
  "version": "2.1.0",
  "main": "index.js",
  "repository": "https://github.com/pandasuite/js-boilerplate-component.git",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "rm -rf ./pandasuite-component.zip && vite build && cd build && zip -r -X '../pandasuite-component.zip' *",
    "release": "yarn build && release-it --no-npm.publish"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@vitejs/plugin-legacy": "6",
    "autoprefixer": "^10.2.5",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^6.0.2",
    "css-loader": "^5.2.6",
    "eslint": "^9.17.0",
    "eslint-config-airbnb-base": "^14.2.0",
    "eslint-plugin-import": "^2.21.2",
    "eslint-plugin-react": "^7.37.3",
    "postcss": "^8.3.0",
    "postcss-loader": "4",
    "release-it": "^13.6.3",
    "style-loader": "^2.0.0",
    "tailwindcss": "^2.1.2",
    "vite": "^6.0.7",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "dependencies": {
    "@ag-grid-community/styles": "^32.3.3",
    "@beingenious/jsoneditor": "^0.13.4",
    "@beingenious/jsonpointer": "^1.0.3",
    "jsondiffpatch": "^0.4.1",
    "lodash": "^4.17.21",
    "pandasuite-bridge": "^5.0.5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "socket.io-client": "^4.2.0"
  },
  "release-it": {
    "github": {
      "release": true,
      "assets": [
        "pandasuite-component.zip"
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "IE >= 9",
      "Android > 0",
      "iOS > 0"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
